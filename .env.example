# EmailJS Credentials
# Get these from your EmailJS account dashboard: https://dashboard.emailjs.com/
#
# VITE_EMAILJS_SERVICE_ID: The Service ID for the EmailJS service you want to use.
# VITE_EMAILJS_TEMPLATE_ID: The Template ID for the email template you've created.
# VITE_EMAILJS_PUBLIC_KEY: Your EmailJS Public Key.

VITE_EMAILJS_SERVICE_ID="YOUR_SERVICE_ID"
VITE_EMAILJS_TEMPLATE_ID="YOUR_TEMPLATE_ID"
VITE_EMAILJS_PUBLIC_KEY="YOUR_PUBLIC_KEY"
